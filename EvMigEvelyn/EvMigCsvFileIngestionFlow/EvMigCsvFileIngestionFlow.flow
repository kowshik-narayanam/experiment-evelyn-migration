      "display": {
        "label": "Manual trigger",
        "icon": "play"
      },
      "inputs": {
        "entryPointId": "db292281-c422-4f51-866a-6abc51caa333",
        "isDefaultEntryPoint": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Data passed when manually triggering the process.",
          "source": "null",
          "var": "output"
        }
      },
      "uniqueId": "6a6888d2-0960-4b48-8832-ee94c5de5fad"
    },
    {
      "id": "csvMonitorTask1",
      "type": "uipath.core.function.ddc7e5ed-cb4d-4bd8-be86-a6233d707b50",
      "typeVersion": "1.0.0",
      "display": {
        "label": "csv-monitor-task",
        "icon": "function"
      },
      "inputs": {},
      "outputs": {
        "output": {
          "type": "object",
          "schema": {
            "type": "object",
            "properties": {
              "rows": {
                "items": {
                  "properties": {
                    "data_file_location": {
                      "title": "Data File Location",
                      "type": "string"
                    },
                    "format_file_location": {
                      "title": "Format File Location",
                      "type": "string"
                    }
                  },
                  "required": [
                    "data_file_location",
                    "format_file_location"
                  ],
                  "title": "DataFileRow",
                  "type": "object"
                },
                "title": "Rows",
                "type": "array"
              },
              "bp_start_time": {
                "title": "Bp Start Time",
                "type": "string"
              }
            }
          },
          "source": "=this",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          },
          "source": "=Error",
          "var": "error"
        }
      },
      "uniqueId": "627d7fe0-ae7b-4108-be27-e5a11231926b"
    },
    {
      "id": "forEachDataFile1",
      "type": "core.logic.loop",
      "typeVersion": "2.4",
      "display": {
        "label": "For each data file",
        "icon": "repeat"
      },
      "inputs": {
        "collection": "=js:$vars.csvMonitorTask1.output.rows",
        "parallel": false,
        "completionCondition": "",
        "breakEnabled": false
      },
      "outputs": {
        "currentItem": {
          "type": "any",
          "description": "The current item being iterated in the loop",
          "scope": "internal",
          "source": "=loopContext.currentItem",
          "var": "currentItem"
        },
        "currentIteration": {
          "type": "number",
          "description": "The current iteration number (1-based)",
          "scope": "internal",
          "source": "=loopContext.currentIteration",
          "var": "currentIteration"
        },
        "collection": {
          "type": "array",
          "description": "The collection being iterated over",
          "scope": "internal",
          "source": "=loopContext.collection",
          "var": "collection"
        },
        "output": {
          "type": "array",
          "description": "Aggregated results from all loop iterations",
          "scope": "external",
          "source": "=loopContext.output",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          },
          "source": "=Error",
          "var": "error"
        }
      },
      "uniqueId": "b6ae9892-c782-4c90-b30f-b8772bdb9a07"
    },
