    {
      "id": "forEachRecord1",
      "type": "core.logic.loop",
      "typeVersion": "2.4",
      "display": {
        "label": "For each record",
        "icon": "repeat"
      },
      "inputs": {
        "collection": "=js:$vars.csvTask1.output.rows",
        "parallel": false,
        "completionCondition": "",
        "breakEnabled": false
      },
      "outputs": {
        "currentItem": {
          "type": "any",
          "description": "The current item being iterated in the loop",
          "scope": "internal",
          "source": "=loopContext.currentItem",
          "var": "currentItem"
        },
        "currentIteration": {
          "type": "number",
          "description": "The current iteration number (1-based)",
          "scope": "internal",
          "source": "=loopContext.currentIteration",
          "var": "currentIteration"
        },
        "collection": {
          "type": "array",
          "description": "The collection being iterated over",
          "scope": "internal",
          "source": "=loopContext.collection",
          "var": "collection"
        },
        "output": {
          "type": "array",
          "description": "Aggregated results from all loop iterations",
          "scope": "external",
          "source": "=loopContext.output",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          },
          "source": "=Error",
          "var": "error"
        }
      },
      "parentId": "forEachDataFile1",
      "uniqueId": "125cbbad-d400-4d16-8de6-38f9c53b5235"
    },
    {
      "id": "shouldProceed1",
      "type": "core.logic.decision",
      "typeVersion": "1.3",
      "display": {
        "label": "Should proceed?",
        "icon": "trending-up-down"
      },
      "inputs": {
        "trueLabel": "Yes",
        "falseLabel": "No",
        "expression": "$vars.forEachRecord1.currentItem.stop !== \"true\""
      },
